<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <PackageId>QuestMail</PackageId>
        <Version>0.0.1</Version>
        <Authors>Erikson Melgarejo</Authors>
        <Description>Build HTML and plain-text email content with a fluent C# API.</Description>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Title>QuestMail</Title>
        <PackageProjectUrl>https://github.com/EriksonGM/QuestMail</PackageProjectUrl>
        <RepositoryUrl>https://github.com/EriksonGM/QuestMail</RepositoryUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>
    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    </ItemGroup>
</Project>
